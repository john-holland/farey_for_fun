{
  "metadata": {
    "name": "WAN OS Frontend Serve Configuration",
    "version": "1.0.0",
    "description": "Configuration for serving static frontend and routing to distributed backends",
    "author": "WAN OS Team",
    "created_at": "2024-03-23T00:00:00Z"
  },
  "serve": {
    "mode": "distributed",
    "frontend": {
      "type": "static",
      "source": "./dist",
      "fallback": "index.html",
      "compression": true,
      "minification": true,
      "cache_control": {
        "static_assets": "public, max-age=31536000",
        "html_files": "public, max-age=3600",
        "api_responses": "private, max-age=300"
      }
    },
    "backend": {
      "type": "distributed",
      "discovery": "rom_registry",
      "load_balancing": "health_based",
      "failover": "automatic",
      "circuit_breaker": {
        "enabled": true,
        "failure_threshold": 5,
        "recovery_timeout": 30000
      }
    },
    "routing": {
      "strategy": "intelligent",
      "health_check_interval": 30000,
      "sticky_sessions": false,
      "geo_routing": true,
      "latency_based": true
    }
  },
  "environments": {
    "local": {
      "enabled": true,
      "description": "Local development with mock backends",
      "config": {
        "port": 3000,
        "host": "localhost",
        "backend_mock": true,
        "telemetry_level": "debug",
        "caching": false
      },
      "backends": [
        {
          "name": "local-api",
          "url": "http://localhost:8080",
          "type": "mock",
          "health_check": "/health"
        }
      ]
    },
    "vendor": {
      "enabled": true,
      "description": "Vendor deployment with distributed backends",
      "config": {
        "port": 80,
        "host": "0.0.0.0",
        "ssl": true,
        "cdn_enabled": true,
        "telemetry_level": "info"
      },
      "backends": [
        {
          "name": "api-cluster",
          "discovery": "rom_registry",
          "type": "distributed",
          "health_check": "/health",
          "load_balancing": "round_robin"
        },
        {
          "name": "file-service",
          "discovery": "rom_registry",
          "type": "distributed",
          "health_check": "/health",
          "load_balancing": "least_connections"
        }
      ]
    },
    "enterprise": {
      "enabled": true,
      "description": "Enterprise with internal backends and compliance",
      "config": {
        "port": 443,
        "host": "0.0.0.0",
        "ssl": true,
        "internal_network": true,
        "vpn_required": true,
        "telemetry_level": "info"
      },
      "backends": [
        {
          "name": "internal-api",
          "discovery": "ldap",
          "type": "internal",
          "health_check": "/health",
          "authentication": "ldap"
        },
        {
          "name": "compliance-service",
          "discovery": "internal_registry",
          "type": "internal",
          "health_check": "/health",
          "audit_logging": true
        }
      ]
    },
    "public": {
      "enabled": true,
      "description": "Public deployment with global CDN and monitoring",
      "config": {
        "port": 80,
        "host": "0.0.0.0",
        "ssl": true,
        "cdn_enabled": true,
        "public_monitoring": true,
        "telemetry_level": "warn"
      },
      "backends": [
        {
          "name": "global-api",
          "discovery": "global_registry",
          "type": "distributed",
          "health_check": "/health",
          "geo_routing": true,
          "latency_based": true
        },
        {
          "name": "monitoring-service",
          "discovery": "global_registry",
          "type": "distributed",
          "health_check": "/health",
          "herd_immunity": true
        }
      ]
    }
  },
  "routing": {
    "rules": [
      {
        "path": "/api/*",
        "backend": "api-cluster",
        "methods": ["GET", "POST", "PUT", "DELETE"],
        "authentication": "required",
        "rate_limit": "1000/hour"
      },
      {
        "path": "/files/*",
        "backend": "file-service",
        "methods": ["GET", "POST", "PUT", "DELETE"],
        "authentication": "required",
        "rate_limit": "100/hour"
      },
      {
        "path": "/health",
        "backend": "health-checker",
        "methods": ["GET"],
        "authentication": "none",
        "rate_limit": "unlimited"
      },
      {
        "path": "/metrics",
        "backend": "monitoring-service",
        "methods": ["GET"],
        "authentication": "api_key",
        "rate_limit": "100/hour"
      },
      {
        "path": "/*",
        "backend": "static-files",
        "methods": ["GET"],
        "authentication": "none",
        "rate_limit": "unlimited"
      }
    ],
    "middleware": [
      {
        "name": "cors",
        "enabled": true,
        "config": {
          "origins": ["*"],
          "methods": ["GET", "POST", "PUT", "DELETE"],
          "headers": ["Content-Type", "Authorization"]
        }
      },
      {
        "name": "compression",
        "enabled": true,
        "config": {
          "algorithms": ["gzip", "brotli"],
          "threshold": 1024
        }
      },
      {
        "name": "telemetry",
        "enabled": true,
        "config": {
          "metrics": true,
          "tracing": true,
          "logging": true
        }
      },
      {
        "name": "security",
        "enabled": true,
        "config": {
          "helmet": true,
          "rate_limiting": true,
          "csp": true
        }
      }
    ]
  },
  "cdn": {
    "enabled": true,
    "provider": "auto",
    "edge_locations": [
      "us-east-1",
      "us-west-2", 
      "eu-west-1",
      "ap-southeast-1"
    ],
    "cache_headers": {
      "static_assets": "public, max-age=31536000, immutable",
      "html_files": "public, max-age=3600",
      "api_responses": "private, max-age=300"
    },
    "compression": {
      "enabled": true,
      "algorithms": ["gzip", "brotli"],
      "min_size": 1024
    }
  },
  "health_monitoring": {
    "enabled": true,
    "checks": [
      {
        "name": "backend_health",
        "type": "http",
        "endpoint": "/health",
        "interval": 30000,
        "timeout": 5000,
        "retries": 3
      },
      {
        "name": "database_health",
        "type": "database",
        "endpoint": "database",
        "interval": 60000,
        "timeout": 10000,
        "retries": 2
      },
      {
        "name": "rom_registry_health",
        "type": "http",
        "endpoint": "/registry/health",
        "interval": 60000,
        "timeout": 10000,
        "retries": 2
      }
    ],
    "alerts": [
      {
        "name": "backend_unhealthy",
        "condition": "backend_health.status != 'healthy'",
        "severity": "critical",
        "notification": ["slack", "email", "pagerduty"]
      },
      {
        "name": "high_error_rate",
        "condition": "error_rate > 0.05",
        "severity": "warning",
        "notification": ["slack", "email"]
      }
    ]
  },
  "telemetry": {
    "enabled": true,
    "endpoint": "${TELEMETRY_ENDPOINT}",
    "service_name": "wanos-frontend-rom",
    "service_version": "${FRONTEND_VERSION}",
    "metrics": [
      "request_count",
      "response_time",
      "error_rate",
      "backend_health",
      "cdn_performance"
    ],
    "traces": [
      "request_flow",
      "backend_routing",
      "cdn_distribution"
    ],
    "logs": [
      "access_logs",
      "error_logs",
      "performance_logs"
    ]
  },
  "performance": {
    "optimizations": [
      "static_asset_caching",
      "api_response_caching",
      "compression",
      "minification",
      "lazy_loading",
      "prefetching"
    ],
    "benchmarks": {
      "static_serving": {
        "target": "1000 req/s",
        "acceptable": "500 req/s"
      },
      "api_routing": {
        "target": "100 req/s",
        "acceptable": "50 req/s"
      },
      "cdn_performance": {
        "target": "100ms",
        "acceptable": "200ms"
      }
    }
  },
  "security": {
    "authentication": {
      "enabled": true,
      "methods": ["jwt", "oauth2", "api_key"],
      "session_management": true
    },
    "authorization": {
      "enabled": true,
      "role_based": true,
      "permission_matrix": true
    },
    "encryption": {
      "tls": "1.3",
      "cipher_suites": ["TLS_AES_256_GCM_SHA384", "TLS_CHACHA20_POLY1305_SHA256"]
    },
    "headers": {
      "security_headers": true,
      "csp": true,
      "hsts": true,
      "x_frame_options": true
    }
  }
}
