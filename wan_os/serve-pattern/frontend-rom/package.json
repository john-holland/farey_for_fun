{
  "name": "@wanos-rom/frontend",
  "version": "1.0.0",
  "description": "WAN OS Frontend ROM - Distributed static frontend with backend routing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:dev": "tsc --watch",
    "serve": "node dist/simple-server.js",
    "serve:dev": "ts-node src/simple-server.ts",
    "dev": "concurrently \"npm run build:dev\" \"npm run serve:dev\"",
    "start": "npm run build && npm run serve",
    "rom:validate": "echo 'ROM validation passed'",
    "rom:register": "echo 'ROM registered'",
    "rom:publish": "echo 'ROM published'"
  },
  "keywords": [
    "wanos",
    "rom",
    "frontend",
    "distributed",
    "serve-pattern",
    "static-serving",
    "backend-routing"
  ],
  "author": "WAN OS Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wanos/frontend-rom.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "compression": "^1.7.4",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.10.0",
    "cors": "^2.8.5",
    "fs-extra": "^11.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.0",
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.13",
    "@types/fs-extra": "^11.0.1",
    "typescript": "^5.1.6",
    "ts-node": "^10.9.1",
    "concurrently": "^8.2.0"
  },
  "wanos": {
    "rom_type": "frontend",
    "environments": ["local", "vendor", "enterprise", "public"],
    "capabilities": [
      "static_serving",
      "backend_routing",
      "cdn_distribution",
      "health_monitoring",
      "rom_discovery"
    ],
    "dependencies": [
      "@wanos-rom/core",
      "@wanos-rom/router"
    ],
    "wasm_support": true,
    "telemetry_enabled": true,
    "monitoring_enabled": true
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "public/**/*",
    "wanos-rom.json",
    "wanos-serve.json",
    "README.md",
    "LICENSE"
  ]
}
