{
  "name": "@wanos-rom/file-processor",
  "version": "1.0.0",
  "description": "WAN OS ROM for file processing operations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:haxe": "haxe build.hxml",
    "test": "jest",
    "rom:validate": "wanos-rom validate",
    "rom:register": "wanos-rom register",
    "rom:publish": "wanos-rom publish"
  },
  "keywords": [
    "wanos",
    "rom",
    "file-processor",
    "file-operations",
    "distributed-computing"
  ],
  "author": "WAN OS Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wanos/file-processor-rom.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@wanos-rom/core": "^1.0.0",
    "fs-extra": "^11.1.0",
    "mime-types": "^2.1.35"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/fs-extra": "^11.0.0",
    "@types/mime-types": "^2.1.0",
    "typescript": "^5.0.0",
    "jest": "^29.0.0"
  },
  "wanos": {
    "rom_type": "file-processor",
    "environments": ["local", "vendor", "enterprise", "public"],
    "capabilities": [
      "file_upload",
      "file_download", 
      "file_conversion",
      "file_compression",
      "file_validation"
    ],
    "dependencies": [
      "@wanos-rom/core"
    ],
    "wasm_support": true,
    "telemetry_enabled": true,
    "monitoring_enabled": true
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "haxe/**/*",
    "wanos-rom.json",
    "README.md",
    "LICENSE"
  ]
}
