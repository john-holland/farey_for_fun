{
  "name": "farey-wan-os",
  "version": "0.1.0",
  "description": "Farey WAN OS with feature toggles and IP management",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:electron\"",
    "dev:web": "cd web/frontend && npm start",
    "dev:electron": "electron .",
    "build": "cd web/frontend && npm run build && electron-builder",
    "test": "jest"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.1.1",
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "aiohttp": "^3.9.3",
    "electron": "^28.2.0",
    "fastapi": "^0.109.2",
    "framer-motion": "^11.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "typescript": "^5.3.3",
    "uvicorn": "^0.27.1",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/electron": "^1.6.10",
    "@types/node": "^20.11.16",
    "@types/react": "^18.2.52",
    "@types/react-dom": "^18.2.18",
    "concurrently": "^8.2.2",
    "electron-builder": "^24.9.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2"
  },
  "build": {
    "appId": "com.farey.wanos",
    "productName": "Farey WAN OS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "web/frontend/build/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
} 